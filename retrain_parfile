# Parameter file to run retraining of the Denosing Auto-encoder

##########################################################################################
# The previously trained model to start from
##########################################################################################
model = /path/to/previously/trained/model.h5
config = /path/to/previously/trained/model.config

##########################################################################################
# Directories and pathnames
##########################################################################################
signal_pathname = /path/to/signal/
noise_pathname = /path/to/noise/
filename = name_of_retrained_model

##########################################################################################
# Parameters for the files containing signal and noise
##########################################################################################
num_per_file = 512                  # Number of traces in each .npz file
num_signals = All                   # Number of signals to use

##########################################################################################
# Parameters for retraining
##########################################################################################
freeze_encoder = True               # Whether to freeze the encoder
validation_split = 0.2              # Validation split of signals. [0-1] -> recommend: 0.2
epochs = 200                        # Number of epochs
learning_rate = 0.000001            # Learning rate for adam optimizer
batch_size = 32                     # Batch size
patience = 10                       # Patience for early stopping callback
verbose = 2                         # Verbosity for training [1-3]
